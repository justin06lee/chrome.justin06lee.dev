{
  "name": "@justin06lee/chrome",
  "version": "0.1.0",
  "description": "components for justin06lee.dev. install via bunx.",
  "type": "module",
  "bin": {
    "chrome": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist --minify --entry-naming=cli.js",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "chrome-ui-registry-builder": "workspace:*",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
