{
  "name": "chrome.ui",
  "version": "0.0.0",
  "description": "components for justin06lee.dev. install via bunx.",
  "type": "module",
  "bin": {
    "chrome.ui": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist --minify --entry-naming=cli.js",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrome-ui-registry-builder": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
