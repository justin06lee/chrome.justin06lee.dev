{
  "name": "chrome-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@justin06lee/site' dev",
    "build": "bun --filter '@justin06lee/site' build",
    "build:registry": "bun --filter 'chrome-ui-registry-builder' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
